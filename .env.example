# Shopify App Configuration
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://your-app.herokuapp.com
SCOPES=write_themes,read_themes,write_content,read_content

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (Future PostgreSQL migration)
DATABASE_URL=postgresql://localhost:5432/shopify_scheduler

# Session Storage
SESSION_SECRET=your_random_session_secret_here

# Optional: Shopify API Version
SHOPIFY_API_VERSION=2025-01
