{% comment %}
  Section Scheduler - Visibility Controller

  This app block loads dynamic JavaScript from the app proxy that removes
  scheduled sections from the DOM before they render.

  The app proxy endpoint (/apps/scheduler/visibility.js) returns JavaScript
  that reads which sections should be hidden from the backend and removes them.

  Benefits:
  - Sections removed from DOM entirely (not just CSS hidden)
  - No Shopify Liquid metafield access limitations
  - Backend has full control via GraphQL API
  - Can switch between JS removal and CSS hiding via query param

  Modes:
  - Default (?mode=js): JavaScript removes sections from DOM
  - Fallback (?mode=css): CSS hides sections with display:none
{% endcomment %}

{% comment %}
  Load the visibility controller script from app proxy
  App proxy configuration maps:
    Store URL: /apps/scheduler/visibility.js
    Backend:   /proxy/visibility.js
{% endcomment %}

{% comment %} Get mode from block settings (defaults to 'js') {% endcomment %}
{% assign visibility_mode = block.settings.mode | default: 'js' %}

{% comment %} Load script/css based on mode {% endcomment %}
{% if visibility_mode == 'inline-css' %}
  {%- comment -%} Inline JavaScript mode: Generate JS directly from metafields {%- endcomment -%}
  {%- comment -%} This mode prevents flickering by removing elements before DOM finishes loading {%- endcomment -%}

  {%- comment -%} Read hidden sections metafield - .value already returns parsed JSON {%- endcomment -%}
  {% assign hidden_sections = shop.metafields.app_scheduler.hidden_sections.value %}

  {%- comment -%} Read hidden blocks metafield - .value already returns parsed JSON {%- endcomment -%}
  {% assign hidden_blocks = shop.metafields.app_scheduler.hidden_blocks.value %}

  {%- comment -%} Only output script if there are sections or blocks to hide {%- endcomment -%}
  {% if hidden_sections != blank or hidden_blocks != blank %}
    <script data-section-scheduler="inline-js">
      /**
       * Section Scheduler - Inline JavaScript Mode
       * Generated at render time from shop metafields
       * Prevents flickering by removing elements as early as possible
       */
      (function() {
        'use strict';

        var hiddenSections = {% if hidden_sections %}{{ hidden_sections | json }}{% else %}[]{% endif %};
        var hiddenBlocks = {% if hidden_blocks %}{{ hidden_blocks | json }}{% else %}{}{% endif %};

        console.log('[Section Scheduler Inline] Hidden sections:', hiddenSections);
        console.log('[Section Scheduler Inline] Hidden blocks:', hiddenBlocks);

        // Function to remove sections
        function removeSections() {
          var removed = 0;
          hiddenSections.forEach(function(sectionId) {
            var selectors = [
              'shopify-section-' + sectionId,
              'Banner-template--' + sectionId,
            ];

            var found = false;
            for (var i = 0; i < selectors.length; i++) {
              var element = document.getElementById(selectors[i]);
              if (element) {
                element.remove();
                removed++;
                found = true;
                break;
              }
            }

            if (!found) {
              var elements = document.querySelectorAll('[id*="__' + sectionId + '"]');
              if (elements.length > 0) {
                elements.forEach(function(el) {
                  el.remove();
                  removed++;
                });
              }
            }
          });

          if (removed > 0) {
            console.log('[Section Scheduler Inline] Removed ' + removed + ' section(s)');
          }
        }

        // Function to remove blocks within sections
        function removeBlocks() {
          var removed = 0;

          for (var sectionId in hiddenBlocks) {
            if (!hiddenBlocks.hasOwnProperty(sectionId)) continue;

            var blocks = hiddenBlocks[sectionId];
            var sectionContainer = document.querySelector('[id*="__' + sectionId + '"]');

            if (!sectionContainer) {
              console.log('[Section Scheduler Inline] Section not found: ' + sectionId);
              continue;
            }

            blocks.forEach(function(block) {
              var blockId = typeof block === 'string' ? block : block.blockId;
              var position = typeof block === 'object' ? block.position : -1;

              // Position-based removal (works for any DOM structure)
              if (position >= 0) {
                var children = Array.from(sectionContainer.children);
                if (children[position]) {
                  console.log('[Section Scheduler Inline] Removing child at position ' + position + ' from ' + sectionId);
                  children[position].remove();
                  removed++;
                }
              } else {
                // Fallback: try to find by block ID in element attributes
                var blockElements = sectionContainer.querySelectorAll('[id*="' + blockId + '"]');
                if (blockElements.length > 0) {
                  blockElements.forEach(function(el) {
                    el.remove();
                    removed++;
                  });
                }
              }
            });
          }

          if (removed > 0) {
            console.log('[Section Scheduler Inline] Removed ' + removed + ' block(s)');
          }
        }

        // Apply hiding immediately
        function applyVisibility() {
          removeSections();
          removeBlocks();
        }

        // Execute as early as possible
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', applyVisibility);
        } else {
          applyVisibility();
        }
      })();
    </script>
  {% endif %}

{% elsif visibility_mode == 'css' %}
  {%- comment -%} CSS mode: Load as stylesheet from proxy {%- endcomment -%}
  <link rel="stylesheet" href="/apps/scheduler/visibility.js?mode=css">
{% else %}
  {%- comment -%} JS mode (default): Load as inline script from proxy {%- endcomment -%}
  <script src="/apps/scheduler/visibility.js?mode=js"></script>
{% endif %}

{% comment %} Debug info - always visible for troubleshooting {% endcomment %}
<script>
  console.log('[Section Scheduler] Visibility mode: {{ visibility_mode }}');
  {% if visibility_mode == 'inline-css' %}
    console.log('[Section Scheduler] Hidden sections:', {{ hidden_sections | json }});
    console.log('[Section Scheduler] Hidden blocks:', {{ hidden_blocks | json }});
    console.log('[Section Scheduler] Hidden sections type:', typeof {{ hidden_sections | json }});
    console.log('[Section Scheduler] Hidden blocks type:', typeof {{ hidden_blocks | json }});
  {% else %}
    console.log('[Section Scheduler] Loading from app proxy: /apps/scheduler/visibility.js?mode={{ visibility_mode }}');
  {% endif %}
</script>

{% schema %}
{
  "name": "Section Scheduler",
  "target": "head",
  "settings": [
    {
      "type": "select",
      "id": "mode",
      "label": "Visibility Mode",
      "options": [
        {
          "value": "inline-css",
          "label": "Inline CSS (recommended - no flicker)"
        },
        {
          "value": "js",
          "label": "JavaScript (removes from DOM)"
        },
        {
          "value": "css",
          "label": "CSS via proxy (display:none)"
        }
      ],
      "default": "inline-css",
      "info": "Inline CSS generates styles at render time to prevent flickering. JavaScript mode removes sections from DOM after load. CSS via proxy loads styles from app backend."
    }
  ]
}
{% endschema %}
