# Production environment variables for Fly.io
# Set these with: fly secrets set KEY=value
# Never commit actual values to git

# Shopify App (from Partner Dashboard)
SHOPIFY_API_KEY=your_api_key_here
SHOPIFY_API_SECRET=your_api_secret_here
SHOPIFY_APP_URL=https://smart-content-scheduler.fly.dev
SCOPES=write_themes,read_themes,write_content,read_content
SHOPIFY_API_VERSION=2025-01

# Server
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# Session (generate with: openssl rand -hex 32)
SESSION_SECRET=your_random_64_char_secret_here

# Redis — provisioned via: fly redis create
# Fly sets this automatically when you attach a Redis instance
REDIS_URL=redis://default:password@fly-redis-name.upstash.io:6379

# Database — provisioned via: fly postgres create
# Fly sets this automatically when you attach a Postgres instance
DATABASE_URL=postgresql://user:password@host:5432/smart_content_scheduler
